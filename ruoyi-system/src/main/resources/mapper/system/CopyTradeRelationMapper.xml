<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.CopyTradeRelationMapper">

    <resultMap id="CopyTradeRelationResult" type="CopyTradeRelation">
        <result property="id" column="id"/>
        <result property="traderId" column="trader_id"/>
        <result property="traderUserId" column="trader_user_id"/>
        <result property="traderUserAccount" column="trader_user_account"/>
        <result property="traderNickName" column="trader_nick_name"/>
        <result property="followerUserId" column="follower_user_id"/>
        <result property="followerUserAccount" column="follower_user_account"/>
        <result property="followerNickName" column="follower_nick_name"/>
        <result property="followMode" column="follow_mode"/>
        <result property="followAmount" column="follow_amount"/>
        <result property="followRatio" column="follow_ratio"/>
        <result property="maxOpenOrders" column="max_open_orders"/>
        <result property="status" column="status"/>
        <result property="delFlag" column="del_flag"/>
        <result property="deleteTime" column="delete_time"/>
        <result property="lastFollowTime" column="last_follow_time"/>
        <result property="currentOpenOrders" column="current_open_orders"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectCopyTradeRelationVo">
        select a.id,
               a.trader_id,
               a.trader_user_id,
               tu.user_account trader_user_account,
               tu.nick_name trader_nick_name,
               a.follower_user_id,
               fu.user_account follower_user_account,
               fu.nick_name follower_nick_name,
               a.follow_mode,
               a.follow_amount,
               a.follow_ratio,
               a.max_open_orders,
               a.status,
               a.del_flag,
               a.delete_time,
               a.last_follow_time,
               a.create_time,
               a.update_time,
               (select count(1) from copy_trade_order o where o.relation_id = a.id and o.status = 0) current_open_orders
        from copy_trade_relation a
                 left join user_info tu on a.trader_user_id = tu.id
                 left join user_info fu on a.follower_user_id = fu.id
    </sql>

    <select id="selectCopyTradeRelationById" parameterType="Long" resultMap="CopyTradeRelationResult">
        <include refid="selectCopyTradeRelationVo"/>
        where a.id = #{id}
          and a.del_flag = 0
    </select>

    <select id="selectRelationByTraderAndFollower" resultMap="CopyTradeRelationResult">
        <include refid="selectCopyTradeRelationVo"/>
        where a.trader_user_id = #{traderUserId}
          and a.follower_user_id = #{followerUserId}
        limit 1
    </select>

    <select id="selectActiveRelationByTraderAndFollower" resultMap="CopyTradeRelationResult">
        <include refid="selectCopyTradeRelationVo"/>
        where a.trader_user_id = #{traderUserId}
          and a.follower_user_id = #{followerUserId}
          and a.status = 0
          and a.del_flag = 0
        limit 1
    </select>

    <select id="selectCopyTradeRelationList" parameterType="CopyTradeRelation" resultMap="CopyTradeRelationResult">
        <include refid="selectCopyTradeRelationVo"/>
        <where>
            <if test="id != null">and a.id = #{id}</if>
            <if test="traderId != null">and a.trader_id = #{traderId}</if>
            <if test="traderUserId != null">and a.trader_user_id = #{traderUserId}</if>
            <if test="followerUserId != null">and a.follower_user_id = #{followerUserId}</if>
            <if test="status != null">and a.status = #{status}</if>
            and a.del_flag = 0
            <if test="traderUserAccount != null and traderUserAccount != ''">and tu.user_account like concat('%',#{traderUserAccount},'%')</if>
            <if test="followerUserAccount != null and followerUserAccount != ''">and fu.user_account like concat('%',#{followerUserAccount},'%')</if>
        </where>
    </select>

    <select id="selectActiveRelationsByTraderUserId" parameterType="Long" resultMap="CopyTradeRelationResult">
        <include refid="selectCopyTradeRelationVo"/>
        where a.trader_user_id = #{traderUserId}
          and a.status = 0
          and a.del_flag = 0
    </select>

    <select id="countActiveFollowerByTraderUserId" parameterType="Long" resultType="int">
        select count(1)
        from copy_trade_relation
        where trader_user_id = #{traderUserId}
          and status = 0
          and del_flag = 0
    </select>

    <insert id="insertCopyTradeRelation" parameterType="CopyTradeRelation" useGeneratedKeys="true" keyProperty="id">
        insert into copy_trade_relation
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="traderId != null">trader_id,</if>
            <if test="traderUserId != null">trader_user_id,</if>
            <if test="followerUserId != null">follower_user_id,</if>
            <if test="followMode != null">follow_mode,</if>
            <if test="followAmount != null">follow_amount,</if>
            <if test="followRatio != null">follow_ratio,</if>
            <if test="maxOpenOrders != null">max_open_orders,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="deleteTime != null">delete_time,</if>
            <if test="lastFollowTime != null">last_follow_time,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="traderId != null">#{traderId},</if>
            <if test="traderUserId != null">#{traderUserId},</if>
            <if test="followerUserId != null">#{followerUserId},</if>
            <if test="followMode != null">#{followMode},</if>
            <if test="followAmount != null">#{followAmount},</if>
            <if test="followRatio != null">#{followRatio},</if>
            <if test="maxOpenOrders != null">#{maxOpenOrders},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="deleteTime != null">#{deleteTime},</if>
            <if test="lastFollowTime != null">#{lastFollowTime},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateCopyTradeRelation" parameterType="CopyTradeRelation">
        update copy_trade_relation
        <trim prefix="set" suffixOverrides=",">
            <if test="traderId != null">trader_id = #{traderId},</if>
            <if test="traderUserId != null">trader_user_id = #{traderUserId},</if>
            <if test="followerUserId != null">follower_user_id = #{followerUserId},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="delFlag != null and delFlag == 0">delete_time = null,</if>
            <if test="deleteTime != null">delete_time = #{deleteTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="followMode != null">follow_mode = #{followMode},</if>
            <if test="followAmount != null">follow_amount = #{followAmount},</if>
            <if test="followRatio != null">follow_ratio = #{followRatio},</if>
            <if test="maxOpenOrders != null">max_open_orders = #{maxOpenOrders},</if>
            <if test="lastFollowTime != null">last_follow_time = #{lastFollowTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCopyTradeRelationByIds" parameterType="Long">
        update copy_trade_relation
        set del_flag = 1,
            status = 1,
            delete_time = sysdate()
        where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
