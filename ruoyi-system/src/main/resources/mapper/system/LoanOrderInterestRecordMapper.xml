<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.LoanOrderInterestRecordMapper">
    
    <resultMap type="LoanOrderInterestRecord" id="LoanOrderInterestRecordResult">
        <result property="id"    column="id"    />
        <result property="loanOrderId"    column="loan_order_id"    />
        <result property="orderPrice"    column="order_price"    />
        <result property="createTime"    column="create_time"    />
        <result property="alreadySettleFlag"    column="already_settle_flag"    />
    </resultMap>

    <sql id="selectLoanOrderInterestRecordVo">
        select id, loan_order_id, order_price, create_time, already_settle_flag from loan_order_interest_record
    </sql>

    <select id="selectLoanOrderInterestRecordList" parameterType="LoanOrderInterestRecord" resultMap="LoanOrderInterestRecordResult">
        <include refid="selectLoanOrderInterestRecordVo"/>
        <where>  
            <if test="orderPrice != null "> and order_price = #{orderPrice}</if>
            <if test="alreadySettleFlag != null "> and already_settle_flag = #{alreadySettleFlag}</if>
            <if test="loanOrderId != null "> and loan_order_id = #{loanOrderId}</if>
        </where>
    </select>
    
    <select id="selectLoanOrderInterestRecordById" parameterType="Long" resultMap="LoanOrderInterestRecordResult">
        <include refid="selectLoanOrderInterestRecordVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertLoanOrderInterestRecord" parameterType="LoanOrderInterestRecord" useGeneratedKeys="true" keyProperty="id">
        insert into loan_order_interest_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="loanOrderId != null">loan_order_id,</if>
            <if test="orderPrice != null">order_price,</if>
            <if test="createTime != null">create_time,</if>
            <if test="alreadySettleFlag != null">already_settle_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="loanOrderId != null">#{loanOrderId},</if>
            <if test="orderPrice != null">#{orderPrice},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="alreadySettleFlag != null">#{alreadySettleFlag},</if>
         </trim>
    </insert>

    <update id="updateLoanOrderInterestRecord" parameterType="LoanOrderInterestRecord">
        update loan_order_interest_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="loanOrderId != null">loan_order_id = #{loanOrderId},</if>
            <if test="orderPrice != null">order_price = #{orderPrice},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="alreadySettleFlag != null">already_settle_flag = #{alreadySettleFlag},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteLoanOrderInterestRecordById" parameterType="Long">
        delete from loan_order_interest_record where id = #{id}
    </delete>

    <delete id="deleteLoanOrderInterestRecordByIds" parameterType="String">
        delete from loan_order_interest_record where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>