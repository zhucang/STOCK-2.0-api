<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.CopyTradeOrderMapper">

    <resultMap id="CopyTradeOrderResult" type="CopyTradeOrder">
        <result property="id" column="id"/>
        <result property="relationId" column="relation_id"/>
        <result property="traderUserId" column="trader_user_id"/>
        <result property="productType" column="product_type"/>
        <result property="leaderPositionId" column="leader_position_id"/>
        <result property="productCode" column="product_code"/>
        <result property="orderDirection" column="order_direction"/>
        <result property="buyOrderPrice" column="buy_order_price"/>
        <result property="followerUserId" column="follower_user_id"/>
        <result property="followerPositionId" column="follower_position_id"/>
        <result property="followMode" column="follow_mode"/>
        <result property="followAmount" column="follow_amount"/>
        <result property="followRatio" column="follow_ratio"/>
        <result property="marginAmount" column="margin_amount"/>
        <result property="orderLever" column="order_lever"/>
        <result property="leaderOrderCode" column="leader_order_code"/>
        <result property="followerOrderCode" column="follower_order_code"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectCopyTradeOrderVo">
        select id,
               relation_id,
               trader_user_id,
               product_type,
               leader_position_id,
               product_code,
               order_direction,
               buy_order_price,
               follower_user_id,
               follower_position_id,
               follow_mode,
               follow_amount,
               follow_ratio,
               margin_amount,
               order_lever,
               leader_order_code,
               follower_order_code,
               status,
               remark,
               create_time,
               update_time
        from copy_trade_order
    </sql>

    <select id="selectCopyTradeOrderById" parameterType="Long" resultMap="CopyTradeOrderResult">
        <include refid="selectCopyTradeOrderVo"/>
        where id = #{id}
    </select>

    <select id="selectCopyTradeOrderList" parameterType="CopyTradeOrder" resultMap="CopyTradeOrderResult">
        <include refid="selectCopyTradeOrderVo"/>
        <where>
            <if test="id != null">and id = #{id}</if>
            <if test="relationId != null">and relation_id = #{relationId}</if>
            <if test="traderUserId != null">and trader_user_id = #{traderUserId}</if>
            <if test="productType != null">and product_type = #{productType}</if>
            <if test="leaderPositionId != null">and leader_position_id = #{leaderPositionId}</if>
            <if test="productCode != null and productCode != ''">and product_code = #{productCode}</if>
            <if test="orderDirection != null">and order_direction = #{orderDirection}</if>
            <if test="followerUserId != null">and follower_user_id = #{followerUserId}</if>
            <if test="followerPositionId != null">and follower_position_id = #{followerPositionId}</if>
            <if test="followMode != null">and follow_mode = #{followMode}</if>
            <if test="status != null">and status = #{status}</if>
        </where>
    </select>

    <select id="selectActiveOrdersByLeaderPositionId" resultMap="CopyTradeOrderResult">
        <include refid="selectCopyTradeOrderVo"/>
        where product_type = #{param1}
          and leader_position_id = #{param2}
          and status = 0
    </select>

    <select id="countActiveOrderByRelationId" parameterType="Long" resultType="int">
        select count(1) from copy_trade_order where relation_id = #{relationId} and status = 0
    </select>

    <insert id="insertCopyTradeOrder" parameterType="CopyTradeOrder" useGeneratedKeys="true" keyProperty="id">
        insert into copy_trade_order
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="relationId != null">relation_id,</if>
            <if test="traderUserId != null">trader_user_id,</if>
            <if test="productType != null">product_type,</if>
            <if test="leaderPositionId != null">leader_position_id,</if>
            <if test="productCode != null and productCode != ''">product_code,</if>
            <if test="orderDirection != null">order_direction,</if>
            <if test="buyOrderPrice != null">buy_order_price,</if>
            <if test="followerUserId != null">follower_user_id,</if>
            <if test="followerPositionId != null">follower_position_id,</if>
            <if test="followMode != null">follow_mode,</if>
            <if test="followAmount != null">follow_amount,</if>
            <if test="followRatio != null">follow_ratio,</if>
            <if test="marginAmount != null">margin_amount,</if>
            <if test="orderLever != null">order_lever,</if>
            <if test="leaderOrderCode != null and leaderOrderCode != ''">leader_order_code,</if>
            <if test="followerOrderCode != null and followerOrderCode != ''">follower_order_code,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="relationId != null">#{relationId},</if>
            <if test="traderUserId != null">#{traderUserId},</if>
            <if test="productType != null">#{productType},</if>
            <if test="leaderPositionId != null">#{leaderPositionId},</if>
            <if test="productCode != null and productCode != ''">#{productCode},</if>
            <if test="orderDirection != null">#{orderDirection},</if>
            <if test="buyOrderPrice != null">#{buyOrderPrice},</if>
            <if test="followerUserId != null">#{followerUserId},</if>
            <if test="followerPositionId != null">#{followerPositionId},</if>
            <if test="followMode != null">#{followMode},</if>
            <if test="followAmount != null">#{followAmount},</if>
            <if test="followRatio != null">#{followRatio},</if>
            <if test="marginAmount != null">#{marginAmount},</if>
            <if test="orderLever != null">#{orderLever},</if>
            <if test="leaderOrderCode != null and leaderOrderCode != ''">#{leaderOrderCode},</if>
            <if test="followerOrderCode != null and followerOrderCode != ''">#{followerOrderCode},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateCopyTradeOrder" parameterType="CopyTradeOrder">
        update copy_trade_order
        <trim prefix="set" suffixOverrides=",">
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCopyTradeOrderByIds" parameterType="Long">
        delete from copy_trade_order where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
