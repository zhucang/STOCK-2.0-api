<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.CopyTradeTraderMapper">

    <resultMap id="CopyTradeTraderResult" type="CopyTradeTrader">
        <result property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="userAccount" column="user_account"/>
        <result property="nickName" column="nick_name"/>
        <result property="email" column="email"/>
        <result property="avatar" column="avatar"/>
        <result property="traderTitle" column="trader_title"/>
        <result property="traderDesc" column="trader_desc"/>
        <result property="status" column="status"/>
        <result property="minFollowAmount" column="min_follow_amount"/>
        <result property="maxFollowAmount" column="max_follow_amount"/>
        <result property="maxFollowerCount" column="max_follower_count"/>
        <result property="defaultFollowMode" column="default_follow_mode"/>
        <result property="defaultFollowRatio" column="default_follow_ratio"/>
        <result property="sort" column="sort"/>
        <result property="currentFollowerCount" column="current_follower_count"/>
        <result property="totalCopyCount" column="total_copy_count"/>
        <result property="totalProfitAmount" column="total_profit_amount"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectCopyTradeTraderVo">
        select a.id,
               a.user_id,
               b.user_account,
               b.nick_name,
               b.email,
               b.avatar,
               a.trader_title,
               a.trader_desc,
               a.status,
               a.min_follow_amount,
               a.max_follow_amount,
               a.max_follower_count,
               a.default_follow_mode,
               a.default_follow_ratio,
               a.sort,
               a.create_time,
               a.update_time,
               (select count(1) from copy_trade_relation r where r.trader_user_id = a.user_id and r.status = 0) current_follower_count,
               (select count(1) from copy_trade_order o where o.trader_user_id = a.user_id) total_copy_count,
               (select ifnull(sum(p.all_profit_and_lose),0)
                from copy_trade_order o
                         left join user_cryptocurrency_position p on p.id = o.follower_position_id
                where o.trader_user_id = a.user_id and p.order_status = 1) total_profit_amount
        from copy_trade_trader a
                 left join user_info b on a.user_id = b.id
    </sql>

    <select id="selectCopyTradeTraderById" parameterType="Long" resultMap="CopyTradeTraderResult">
        <include refid="selectCopyTradeTraderVo"/>
        where a.id = #{id}
    </select>

    <select id="selectActiveCopyTradeTraderByUserId" parameterType="Long" resultMap="CopyTradeTraderResult">
        <include refid="selectCopyTradeTraderVo"/>
        where a.user_id = #{userId} and a.status = 0
        limit 1
    </select>

    <select id="selectCopyTradeTraderList" parameterType="CopyTradeTrader" resultMap="CopyTradeTraderResult">
        <include refid="selectCopyTradeTraderVo"/>
        <where>
            <if test="id != null">and a.id = #{id}</if>
            <if test="userId != null">and a.user_id = #{userId}</if>
            <if test="userAccount != null and userAccount != ''">and b.user_account like concat('%',#{userAccount},'%')</if>
            <if test="nickName != null and nickName != ''">and b.nick_name like concat('%',#{nickName},'%')</if>
            <if test="status != null">and a.status = #{status}</if>
        </where>
    </select>

    <insert id="insertCopyTradeTrader" parameterType="CopyTradeTrader" useGeneratedKeys="true" keyProperty="id">
        insert into copy_trade_trader
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="traderTitle != null and traderTitle != ''">trader_title,</if>
            <if test="traderDesc != null and traderDesc != ''">trader_desc,</if>
            <if test="status != null">status,</if>
            <if test="minFollowAmount != null">min_follow_amount,</if>
            <if test="maxFollowAmount != null">max_follow_amount,</if>
            <if test="maxFollowerCount != null">max_follower_count,</if>
            <if test="defaultFollowMode != null">default_follow_mode,</if>
            <if test="defaultFollowRatio != null">default_follow_ratio,</if>
            <if test="sort != null">sort,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="traderTitle != null and traderTitle != ''">#{traderTitle},</if>
            <if test="traderDesc != null and traderDesc != ''">#{traderDesc},</if>
            <if test="status != null">#{status},</if>
            <if test="minFollowAmount != null">#{minFollowAmount},</if>
            <if test="maxFollowAmount != null">#{maxFollowAmount},</if>
            <if test="maxFollowerCount != null">#{maxFollowerCount},</if>
            <if test="defaultFollowMode != null">#{defaultFollowMode},</if>
            <if test="defaultFollowRatio != null">#{defaultFollowRatio},</if>
            <if test="sort != null">#{sort},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateCopyTradeTrader" parameterType="CopyTradeTrader">
        update copy_trade_trader
        <trim prefix="set" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="traderTitle != null">trader_title = #{traderTitle},</if>
            <if test="traderDesc != null">trader_desc = #{traderDesc},</if>
            <if test="status != null">status = #{status},</if>
            <if test="minFollowAmount != null">min_follow_amount = #{minFollowAmount},</if>
            <if test="maxFollowAmount != null">max_follow_amount = #{maxFollowAmount},</if>
            <if test="maxFollowerCount != null">max_follower_count = #{maxFollowerCount},</if>
            <if test="defaultFollowMode != null">default_follow_mode = #{defaultFollowMode},</if>
            <if test="defaultFollowRatio != null">default_follow_ratio = #{defaultFollowRatio},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCopyTradeTraderByIds" parameterType="Long">
        delete from copy_trade_trader where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
