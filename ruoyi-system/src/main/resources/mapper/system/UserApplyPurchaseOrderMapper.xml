    <sql id="selectUserApplyPurchaseOrderVo">
        select a.id, order_code,  product_name, product_code, user_id,user_account,nick_name,account_type,agent_id,agent_name, d.remark user_remark, apply_purchase_time, apply_purchase_amount, apply_purchase_quantity, apply_purchase_single_amount, a.listing_start_date, winning_rate, winning_amount, winning_quantity, sell_price, sell_time, profit_and_lose, new_product_apply_purchase_id, a.status, a.sql_version,a.product_type,lock_flag,un_lock_time,product_name_en, product_name_tc, product_name_de, product_name_es, product_name_fr, product_name_idn, product_name_jp, product_name_ko, product_name_my, product_name_th, product_name_vi, product_name_pt, product_name_rus, product_name_blr, product_name_ida, product_name_sa, product_name_ar, product_name_it, product_name_tr
        from user_apply_purchase_order a
                 left join new_product_apply_purchase b
                           on new_product_apply_purchase_id = b.id
                 left join self_sell_product c
                           on self_sell_product_id = c.id
                 left join user_info d
                           on a.user_id = d.id
    </sql>

    <select id="selectUserApplyPurchaseOrderList" parameterType="UserApplyPurchaseOrder" resultMap="UserApplyPurchaseOrderResult">
        <include refid="selectUserApplyPurchaseOrderVo"/>
        <where>  
            <if test="orderCode != null  and orderCode != ''"> and order_code  like concat('%',#{orderCode},'%')</if>
            <if test="productCode != null  and productCode != ''"> and product_code = #{productCode}</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="userAccount != null "> and user_account like concat('%',#{userAccount},'%') </if>
            <if test="nickName != null "> and nick_name like concat('%',#{nickName},'%') </if>
            <if test="accountType != null "> and account_type = #{accountType}</if>
            <if test="applyPurchaseTime != null  and applyPurchaseTime != ''"> and apply_purchase_time = #{applyPurchaseTime}</if>
            <if test="applyPurchaseAmount != null "> and apply_purchase_amount = #{applyPurchaseAmount}</if>
            <if test="applyPurchaseQuantity != null "> and apply_purchase_quantity = #{applyPurchaseQuantity}</if>
            <if test="applyPurchaseSingleAmount != null "> and apply_purchase_single_amount = #{applyPurchaseSingleAmount}</if>
            <if test="listingStartDate != null"> and a.listing_start_date = #{listingStartDate}</if>
            <if test="winningRate != null "> and winning_rate = #{winningRate}</if>
            <if test="winningAmount != null "> and winning_amount = #{winningAmount}</if>
            <if test="winningQuantity != null "> and winning_quantity = #{winningQuantity}</if>
            <if test="sellPrice != null "> and sell_price = #{sellPrice}</if>
            <if test="sellTime != null "> and sell_time = #{sellTime}</if>
            <if test="profitAndLose != null "> and profit_and_lose = #{profitAndLose}</if>
            <if test="newProductApplyPurchaseId != null "> and new_product_apply_purchase_id = #{newProductApplyPurchaseId}</if>
            <if test="status != null "> and a.status = #{status}</if>
            <if test="productType != null "> and a.product_type = #{productType}</if>
            <if test="lockFlag != null "> and a.lock_flag = #{lockFlag}</if>
            <if test="unLockTime != null "> and un_lock_time <![CDATA[ <= ]]> #{unLockTime}</if>
            ${params.dataScope}
        </where>
    </select>
    
    <select id="selectUserApplyPurchaseOrderById" parameterType="Long" resultMap="UserApplyPurchaseOrderResult">
        <include refid="selectUserApplyPurchaseOrderVo"/>
        where a.id = #{id}
    </select>

    <select id="getUserBibiOrderLockAmount" resultType="java.math.BigDecimal">
        select IFNULL(sum(winning_quantity),0)
        from user_apply_purchase_order a
        left join new_product_apply_purchase b
        on new_product_apply_purchase_id = b.id
        left join self_sell_product c
        on self_sell_product_id = c.id
        where a.product_type = #{productType} and product_code = #{productCode} and user_id = #{userId}
        and lock_flag = 0 and un_lock_time <![CDATA[ > ]]> #{nowDateTime}
    </select>

