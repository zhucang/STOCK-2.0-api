<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.FastOrderControlConfigMapper">
    
    <resultMap type="FastOrderControlConfig" id="FastOrderControlConfigResult">
        <result property="id"    column="id"    />
        <result property="productCode"    column="product_code"    />
        <result property="productType"    column="product_type"    />
        <result property="beginTime"    column="begin_time"    />
        <result property="finishTime"    column="finish_time"    />
        <result property="tradeDirect"    column="trade_direct"    />
        <result property="status"    column="status"    />
        <result property="winOrLose"    column="win_or_lose"    />
    </resultMap>

    <sql id="selectFastOrderControlConfigVo">
        select id, product_code, product_type, begin_time, finish_time, trade_direct, status, win_or_lose from fast_order_control_config
    </sql>

    <select id="selectFastOrderControlConfigList" parameterType="FastOrderControlConfig" resultMap="FastOrderControlConfigResult">
        <include refid="selectFastOrderControlConfigVo"/>
        <where>  
            <if test="productCode != null  and productCode != ''"> and product_code like concat('%', #{productCode}, '%')</if>
            <if test="productType != null "> and product_type = #{productType}</if>
            <if test="beginTime != null "> and begin_time = #{beginTime}</if>
            <if test="finishTime != null "> and finish_time = #{finishTime}</if>
            <if test="tradeDirect != null "> and trade_direct = #{tradeDirect}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="winOrLose != null "> and win_or_lose = #{winOrLose}</if>
            <if test="params.productCodes != null and params.productCodes.size > 0">
                and product_code in
                <foreach collection="params.productCodes" index="index" item="item" open="(" close=")" separator="," nullable="true">
                    #{item}
                </foreach>
            </if>
            <if test="params.productCodes != null and params.productCodes.size == 0">
                and id = 0
            </if>
            <if test="params.ids != null and params.ids.size > 0">
                and id in
                <foreach collection="params.ids" index="index" item="item" open="(" close=")" separator="," nullable="true">
                    #{item}
                </foreach>
            </if>
            <if test="params.ids != null and params.ids.size == 0">
                and id = 0
            </if>
        </where>
    </select>
    
    <select id="selectFastOrderControlConfigById" parameterType="Long" resultMap="FastOrderControlConfigResult">
        <include refid="selectFastOrderControlConfigVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertFastOrderControlConfig" parameterType="FastOrderControlConfig" useGeneratedKeys="true" keyProperty="id">
        insert into fast_order_control_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="productCode != null and productCode != ''">product_code,</if>
            <if test="productType != null">product_type,</if>
            <if test="beginTime != null">begin_time,</if>
            <if test="finishTime != null">finish_time,</if>
            <if test="tradeDirect != null">trade_direct,</if>
            <if test="status != null">status,</if>
            <if test="winOrLose != null">win_or_lose,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="productCode != null and productCode != ''">#{productCode},</if>
            <if test="productType != null">#{productType},</if>
            <if test="beginTime != null">#{beginTime},</if>
            <if test="finishTime != null">#{finishTime},</if>
            <if test="tradeDirect != null">#{tradeDirect},</if>
            <if test="status != null">#{status},</if>
            <if test="winOrLose != null">#{winOrLose},</if>
         </trim>
    </insert>

    <update id="updateFastOrderControlConfig" parameterType="FastOrderControlConfig">
        update fast_order_control_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="productCode != null and productCode != ''">product_code = #{productCode},</if>
            <if test="productType != null">product_type = #{productType},</if>
            <if test="beginTime != null">begin_time = #{beginTime},</if>
            <if test="finishTime != null">finish_time = #{finishTime},</if>
            <if test="tradeDirect != null">trade_direct = #{tradeDirect},</if>
            <if test="status != null">status = #{status},</if>
            <if test="winOrLose != null">win_or_lose = #{winOrLose},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteFastOrderControlConfigById" parameterType="Long">
        delete from fast_order_control_config where id = #{id}
    </delete>

    <delete id="deleteFastOrderControlConfigByIds" parameterType="String">
        delete from fast_order_control_config where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>