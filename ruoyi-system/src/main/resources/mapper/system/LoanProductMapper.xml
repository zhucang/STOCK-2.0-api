            <if test="productNameLang.en != null">product_name_en = #{productNameLang.en},</if>
            <if test="productNameLang.tc != null">product_name_tc = #{productNameLang.tc},</if>
            <if test="productNameLang.de != null">product_name_de = #{productNameLang.de},</if>
            <if test="productNameLang.es != null">product_name_es = #{productNameLang.es},</if>
            <if test="productNameLang.fr != null">product_name_fr = #{productNameLang.fr},</if>
            <if test="productNameLang.idn != null">product_name_idn = #{productNameLang.idn},</if>
            <if test="productNameLang.jp != null">product_name_jp = #{productNameLang.jp},</if>
            <if test="productNameLang.ko != null">product_name_ko = #{productNameLang.ko},</if>
