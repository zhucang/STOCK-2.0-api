    <sql id="selectLoanProductVo">
        select a.id, product_name, product_img, min_price, max_price, loan_days, interest_free_days, loan_daily_rate, break_contract_daily_rate,max_loan_count,interest_settlement_method,repayment_method, a.status, a.sort, currency_id,currency_name, create_time, product_name_en, product_name_tc, product_name_de, product_name_es, product_name_fr, product_name_idn, product_name_jp, product_name_ko, product_name_my, product_name_th, product_name_vi, product_name_pt, product_name_rus, product_name_blr, product_name_ida, product_name_sa, product_name_ar, product_name_it, product_name_tr
        from loan_product a
                 left join platform_currency b
                           on a.currency_id = b.id
    </sql>

    <select id="selectLoanProductList" parameterType="LoanProduct" resultMap="LoanProductResult">
        <include refid="selectLoanProductVo"/>
        <where>  
            <if test="productName != null  and productName != ''"> and product_name like concat('%', #{productName}, '%')</if>
            <if test="productImg != null  and productImg != ''"> and product_img = #{productImg}</if>
            <if test="minPrice != null "> and min_price = #{minPrice}</if>
            <if test="maxPrice != null "> and max_price = #{maxPrice}</if>
            <if test="loanDays != null "> and loan_days = #{loanDays}</if>
            <if test="interestFreeDays != null "> and interest_free_days = #{interestFreeDays}</if>
            <if test="loanDailyRate != null "> and loan_daily_rate = #{loanDailyRate}</if>
            <if test="breakContractDailyRate != null "> and break_contract_daily_rate = #{breakContractDailyRate}</if>
            <if test="interestSettlementMethod != null "> and interest_settlement_method = #{interestSettlementMethod}</if>
            <if test="repaymentMethod != null "> and repayment_method = #{repaymentMethod}</if>
            <if test="status != null "> and a.status = #{status}</if>
            <if test="sort != null "> and a.sort = #{sort}</if>
            <if test="currencyId != null "> and currency_id = #{currencyId}</if>
            <if test="params.ids != null and params.ids.size > 0">
                and a.id in
                <foreach collection="params.ids" index="index" item="item" open="(" close=")" separator="," nullable="true">
                    #{item}
                </foreach>
            </if>
            <if test="params.ids != null and params.ids.size == 0">
                and a.id = 0
            </if>
        </where>
    </select>
    
    <select id="selectLoanProductById" parameterType="Long" resultMap="LoanProductResult">
        <include refid="selectLoanProductVo"/>
        where a.id = #{id}
    </select>
        
    <insert id="insertLoanProduct" parameterType="LoanProduct" useGeneratedKeys="true" keyProperty="id">
        insert into loan_product
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="productName != null and productName != ''">product_name,</if>
            <if test="productImg != null">product_img,</if>
            <if test="minPrice != null">min_price,</if>
            <if test="maxPrice != null">max_price,</if>
            <if test="loanDays != null">loan_days,</if>
            <if test="interestFreeDays != null">interest_free_days,</if>
            <if test="loanDailyRate != null">loan_daily_rate,</if>
            <if test="breakContractDailyRate != null">break_contract_daily_rate,</if>
            <if test="maxLoanCount != null">max_loan_count,</if>
            <if test="interestSettlementMethod != null">interest_settlement_method,</if>
            <if test="repaymentMethod != null">repayment_method,</if>
            <if test="status != null">status,</if>
            <if test="sort != null">sort,</if>
            <if test="currencyId != null">currency_id,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="productName != null and productName != ''">#{productName},</if>
            <if test="productImg != null">#{productImg},</if>
            <if test="minPrice != null">#{minPrice},</if>
            <if test="maxPrice != null">#{maxPrice},</if>
            <if test="loanDays != null">#{loanDays},</if>
            <if test="interestFreeDays != null">#{interestFreeDays},</if>
            <if test="loanDailyRate != null">#{loanDailyRate},</if>
            <if test="breakContractDailyRate != null">#{breakContractDailyRate},</if>
            <if test="maxLoanCount != null">#{maxLoanCount},</if>
            <if test="interestSettlementMethod != null">#{interestSettlementMethod},</if>
            <if test="repaymentMethod != null">#{repaymentMethod},</if>
