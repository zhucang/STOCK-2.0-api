            <if test="currencyId != null">#{currencyId},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateLoanProduct" parameterType="LoanProduct">
        update loan_product
        <trim prefix="SET" suffixOverrides=",">
            <if test="productName != null and productName != ''">product_name = #{productName},</if>
            <if test="productImg != null">product_img = #{productImg},</if>
            <if test="minPrice != null">min_price = #{minPrice},</if>
            <if test="maxPrice != null">max_price = #{maxPrice},</if>
            <if test="loanDays != null">loan_days = #{loanDays},</if>
            <if test="interestFreeDays != null">interest_free_days = #{interestFreeDays},</if>
            <if test="loanDailyRate != null">loan_daily_rate = #{loanDailyRate},</if>
            <if test="breakContractDailyRate != null">break_contract_daily_rate = #{breakContractDailyRate},</if>
