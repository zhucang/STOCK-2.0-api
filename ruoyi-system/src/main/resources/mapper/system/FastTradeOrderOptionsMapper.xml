    <sql id="selectFastTradeOrderOptionsVo">
        select id, product_name, product_code, product_type,vip_level_limit,sort, duration_value, duration_label,(case duration_label WHEN 0 THEN 1 WHEN 1 THEN 60 WHEN 2 THEN 3600 else null end )as duration_label_value, status, up_win_profit_ratio,up_lose_profit_ratio, up_fluctuation_ratio, down_win_profit_ratio,down_lose_profit_ratio, down_fluctuation_ratio, min_buy_amount, max_buy_amount, min_user_amount, profit_ratio_method, lose_money_method, create_by, create_time, update_by, update_time from fast_trade_order_options
    </sql>

    <select id="selectFastTradeOrderOptionsList" parameterType="FastTradeOrderOptions" resultMap="FastTradeOrderOptionsResult">
        <include refid="selectFastTradeOrderOptionsVo"/>
        <where>
            <if test="productCode != null  and productCode != ''"> and product_code = #{productCode}</if>
            <if test="productType != null "> and product_type = #{productType}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="vipLevelLimit != null "> and vip_level_limit = #{vipLevelLimit}</if>
            <if test="durationValue != null "> and duration_value = #{durationValue}</if>
            <if test="params.ids != null and params.ids.size > 0">
                and id in
                <foreach collection="params.ids" index="index" item="item" open="(" close=")" separator="," nullable="true">
                    #{item}
                </foreach>
            </if>
            <if test="params.ids != null and params.ids.size == 0">
                and id = 0
            </if>
        </where>
    </select>
    
    <select id="selectFastTradeOrderOptionsById" parameterType="Long" resultMap="FastTradeOrderOptionsResult">
        <include refid="selectFastTradeOrderOptionsVo"/>
        where id = #{id}
    </select>
        
