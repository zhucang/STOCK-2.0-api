    <insert id="insertFastTradeOrderOptionsList">
        insert into fast_trade_order_options (product_name,product_code,product_type,duration_value,duration_label,status,up_win_profit_ratio,up_lose_profit_ratio,up_fluctuation_ratio,
                                              down_win_profit_ratio,down_lose_profit_ratio,down_fluctuation_ratio,min_buy_amount,max_buy_amount,min_user_amount,create_by,create_time,
                                              profit_ratio_method,lose_money_method,vip_level_limit,sort) values
